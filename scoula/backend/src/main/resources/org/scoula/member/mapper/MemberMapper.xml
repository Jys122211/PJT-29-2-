<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.scoula.member.mapper.MemberMapper">
    <resultMap id="memberMap" type="org.scoula.security.account.domain.MemberVO">
        <id property="email" column="email"/>
        <result property="userId" column="user_id"/>
        <result property="email" column="email"/>
        <result property="password" column="password_hash"/>
        <result property="name" column="name"/>
        <result property="creditScore" column="credit_score"/>
        <result property="maxMonthlyPayment" column="max_monthly_payment"/>
        <result property="isDeleted" column="is_deleted"/>
        <result property="createdAt" column="created_at"/>
        <result property="createdBy" column="created_by"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="updatedBy" column="updated_by"/>
    </resultMap>

    <update id="update">
        UPDATE users
        SET name = #{name},
            credit_score = #{creditScore},
            max_monthly_payment = #{maxMonthlyPayment},
            updated_at = now()
        WHERE email = #{email}
    </update>

    <update id="updatePassword">
        UPDATE users
        SET password_hash = #{newPassword},
            updated_at = now()
        WHERE email = #{email}
    </update>

    <update id="updateCreditScore">
        UPDATE users
        SET credit_score = #{creditScore},
            updated_at = now()
        WHERE user_id = #{userId}
    </update>

    <update id="updateMaxMonthlyPayment">
        UPDATE users
        SET max_monthly_payment = #{maxMonthlyPayment},
            updated_at = now()
        WHERE user_id = #{userId}
    </update>

    <select id="get" resultMap="memberMap">
        SELECT *
        FROM users
        where user_id = #{userId}
    </select>

    <select id="findByEmail" resultMap="memberMap">
        SELECT *
        FROM users
        WHERE email = #{email}
    </select>

    <insert id="insert">
        INSERT INTO users (
            email,
            password_hash,
            name,
            credit_score,
            max_monthly_payment
        )
        VALUES (
            #{email},
            #{password},
            #{name},
            #{creditScore},
            #{maxMonthlyPayment}
        )
    </insert>

    <!-- 권한 테이블이 없으므로 더미로 처리하거나 삭제 가능하나 인터페이스 유지를 위해 남겨둠 -->
    <insert id="insertAuth">
        <!-- DB에 권한 테이블이 없으므로 빈 쿼리 또는 주석 처리 -->
    </insert>
</mapper>
