<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.scoula.member.mapper.MemberMapper">
    <resultMap id="memberMap" type="org.scoula.security.account.domain.MemberVO">
        <id property="email" column="email"/>
        <result property="userId" column="user_id"/>
        <result property="email" column="email"/>
        <result property="password" column="password_hash"/>
        <result property="name" column="name"/>
        <result property="creditScore" column="credit_score"/>
        <result property="maxMonthlyPayment" column="max_monthly_payment"/>
        <result property="isDeleted" column="is_deleted"/>
        <result property="createdAt" column="created_at"/>
        <result property="createdBy" column="created_by"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="updatedBy" column="updated_by"/>
    </resultMap>

    <update id="update">
        UPDATE users
        SET name = #{name},
            credit_score = #{creditScore},
            max_monthly_payment = #{maxMonthlyPayment},
            updated_at = now()
        WHERE user_id = #{userId}
    </update>

    <update id="updateCreditScore">
        UPDATE users
        SET credit_score = #{creditScore},
            updated_at = now()
        WHERE user_id = #{userId}
    </update>

    <update id="updateMaxMonthlyPayment">
        UPDATE users
        SET max_monthly_payment = #{maxMonthlyPayment},
            updated_at = now()
        WHERE user_id = #{userId}
    </update>

    <update id="updateName">
        UPDATE users
        SET name = #{name},
            updated_at = now()
        WHERE user_id = #{userId}
    </update>

    <update id="updateEmail">
        UPDATE users
        SET email = #{email},
            updated_at = now()
        WHERE user_id = #{userId}
    </update>

    <select id="get" resultMap="memberMap">
        SELECT *
        FROM users
        where user_id = #{userId}
    </select>

    <!--
        이메일 중복 확인용. 탈퇴한 계정은 재가입을 막지 않아야 하므로 활성 회원만 조회한다.
        (탈퇴 시 이메일을 익명화하지만, 익명화 이전에 탈퇴한 데이터를 위해 조건을 함께 둔다.)
    -->
    <select id="findByEmail" resultMap="memberMap">
        SELECT *
        FROM users
        WHERE email = #{email}
          AND is_deleted = 'N'
    </select>

    <insert id="insert">
        INSERT INTO users (
            email,
            password_hash,
            name,
            credit_score,
            max_monthly_payment
        )
        VALUES (
            #{email},
            #{password},
            #{name},
            #{creditScore},
            #{maxMonthlyPayment}
        )
    </insert>

    <!-- 권한 테이블이 없으므로 더미로 처리하거나 삭제 가능하나 인터페이스 유지를 위해 남겨둠 -->
    <insert id="insertAuth">
        <!-- DB에 권한 테이블이 없으므로 빈 쿼리 또는 주석 처리 -->
    </insert>

    <!--
        탈퇴 시 관련 데이터 삭제를 위한 쿼리들.

        email 컬럼에 UNIQUE 제약(uk_users_email)이 걸려 있어, 논리 삭제만 하면 탈퇴한 행이
        그 이메일을 계속 점유해 같은 주소로 재가입할 수 없다. 그래서 탈퇴 시점에 이메일을
        실존하지 않는 값으로 바꿔 자리를 비워준다(개인정보 파기 원칙에도 부합).

        user_id 뒤에 타임스탬프를 붙이는 것은, 만에 하나 같은 행이 두 번 탈퇴 처리되어도
        익명화된 이메일끼리 충돌하지 않게 하기 위함이다.
    -->
    <update id="deleteUser">
        UPDATE users
        SET is_deleted = 'Y',
            email      = CONCAT('deleted_', user_id, '_', UNIX_TIMESTAMP(), '@deleted.local'),
            updated_at = now()
        WHERE user_id = #{userId}
          AND is_deleted = 'N'
    </update>
</mapper>
