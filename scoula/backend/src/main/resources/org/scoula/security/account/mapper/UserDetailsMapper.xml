<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.scoula.security.account.mapper.UserDetailsMapper">

    <resultMap id="authMap" type="org.scoula.security.account.domain.AuthVO">
        <id property="auth" column="auth"/>
    </resultMap>

    <resultMap id="memberMap" type="org.scoula.security.account.domain.MemberVO">
        <id property="userId" column="user_id"/>
        <result property="username" column="email"/>
        <result property="password" column="password_hash"/>
        <result property="email" column="email"/>
        <result property="name" column="name"/>
        <result property="creditScore" column="credit_score"/>
        <result property="maxMonthlyPayment" column="max_monthly_payment"/>
        <result property="isDeleted" column="is_deleted"/>
        <result property="createdAt" column="created_at"/>
        <result property="createdBy" column="created_by"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="updatedBy" column="updated_by"/>
        <collection property="authList" resultMap="authMap"/>
    </resultMap>

    <select id="get" resultMap="memberMap">
        SELECT
            user_id,
            email,
            password_hash,
            name,
            credit_score,
            max_monthly_payment,
            is_deleted,
            created_at,
            created_by,
            updated_at,
            updated_by,
            'ROLE_USER' AS auth
        FROM users
        WHERE email = #{email}
          AND is_deleted = 'N'
    </select>
</mapper>
